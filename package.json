{
  "name": "scriptcut",
  "version": "0.1.0",
  "private": true,
  "author": "Fernando Abishai",
  "description": "ScriptCut — Open-source AI-powered text-based video editor",
  "keywords": ["video-editor", "text-based-video-editing", "descript-alternative", "transcript-editor", "youtube-shorts", "tiktok", "reels", "shorts-editor", "social-video", "video-transcription", "creator-tools", "captions", "ffmpeg", "local-first", "electron"],
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "electron .",
    "dev:backend": "node electron/run-backend.js --reload --port 8642",
    "setup": "node scripts/setup.js",
    "setup:backend": "node scripts/setup.js --backend-only",
    "doctor": "node scripts/doctor.js",
    "build": "cd frontend && npm run build && electron-builder",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg",
    "dist:mac:arm64": "npm run build:frontend && electron-builder --mac dmg --arm64",
    "dist:mac:x64": "npm run build:frontend && electron-builder --mac dmg --x64",
    "dist:dir": "npm run build:frontend && electron-builder --dir",
    "dist:dir:arm64": "npm run build:frontend && electron-builder --dir --arm64",
    "dist:dir:x64": "npm run build:frontend && electron-builder --dir --x64",
    "release:icons": "node scripts/generate-icons.js",
    "check:macos-icon": "node scripts/check-macos-icon.js",
    "release:ffmpeg": "node scripts/prepare-ffmpeg-bundle.js",
    "release:platform": "node scripts/release-platform.js",
    "check:packaged-ffmpeg": "node scripts/check-packaged-ffmpeg.js",
    "qa:desktop": "node scripts/desktop-qa.js",
    "qa:desktop:package": "node scripts/desktop-qa.js --package",
    "release:alpha": "node scripts/release-alpha.js --candidate",
    "release:rc:arm64": "node scripts/release-alpha.js --candidate",
    "release:trust": "node scripts/check-release-trust.js --candidate",
    "release:trust:candidate": "node scripts/check-release-trust.js --candidate",
    "release:trust:signed": "node scripts/check-release-trust.js --signed",
    "runtime:prepare:mac-arm64": "node scripts/prepare-python-runtime.js --target darwin-arm64",
    "dist:dir:arm64:self-contained": "npm run build:frontend && npm run runtime:prepare:mac-arm64 && electron-builder --config electron-builder.self-contained.cjs --dir --arm64 && npm run check:packaged-runtime && npm run smoke:packaged-backend",
    "dist:mac:arm64:self-contained": "npm run build:frontend && npm run runtime:prepare:mac-arm64 && electron-builder --config electron-builder.self-contained.cjs --mac dmg --arm64 && npm run check:packaged-runtime && npm run smoke:packaged-backend",
    "check:packaged-runtime": "node scripts/check-packaged-runtime.js --arch arm64",
    "smoke:packaged-backend": "node scripts/smoke-packaged-backend.js --arch arm64",
    "smoke:packaged-transcription": "node scripts/smoke-packaged-transcription.js --arch arm64",
    "smoke:packaged-optional-capabilities": "node scripts/smoke-packaged-optional-capabilities.js --arch arm64",
    "smoke:release-metadata": "node scripts/smoke-release-metadata.js",
    "smoke:release-notes": "node scripts/smoke-release-notes.js",
    "smoke:bundle-size": "node scripts/smoke-bundle-size.js",
    "smoke:published-release": "node scripts/smoke-published-release.js",
    "smoke:release-identity": "node scripts/smoke-release-identity.js",
    "release:public:prepare": "node scripts/prepare-public-release.js",
    "check:public-release": "node scripts/check-public-release.js",
    "smoke:public-release": "node scripts/smoke-public-release.js",
    "smoke:release-workflow": "node scripts/check-release-workflow.js",
    "smoke:external-beta": "node scripts/smoke-external-beta.js",
    "beta:fixture": "node scripts/generate-beta-fixture.js",
    "smoke:signing-readiness": "node scripts/check-macos-signing-readiness.js",
    "lint": "cd frontend && npm run lint",
    "smoke:backend": "cd backend && (../.venv311/bin/python -m unittest discover -s scripts -p 'smoke_*.py' -v || ../.venv/bin/python -m unittest discover -s scripts -p 'smoke_*.py' -v || python -m unittest discover -s scripts -p 'smoke_*.py' -v)",
    "test:qualification-harness": "node scripts/smoke-phase-5b6a-qualification.mjs",
    "smoke:model-manager": "cd backend && (../.venv311/bin/python -m unittest scripts/smoke_model_manager.py -v || ../.venv/bin/python -m unittest scripts/smoke_model_manager.py -v || python -m unittest scripts/smoke_model_manager.py -v)",
    "smoke:transcription": "cd backend && (../.venv311/bin/python -m unittest scripts/smoke_transcription.py -v || ../.venv/bin/python -m unittest scripts/smoke_transcription.py -v || python -m unittest scripts/smoke_transcription.py -v)",
    "smoke:runtime-contract": "node scripts/smoke-runtime-contract.js",
    "smoke:runtime-artifacts": "node scripts/smoke-runtime-artifacts.js",
    "smoke:brand": "node scripts/smoke-brand-assets.js",
    "smoke:renderer-policy": "node scripts/smoke-packaged-renderer-policy.js"
  },
  "devDependencies": {"concurrently": "^9.1.0", "electron": "^43.1.0", "electron-builder": "^26.15.3", "wait-on": "^8.0.0"},
  "dependencies": {"python-shell": "^5.0.0"},
  "build": {
    "appId": "com.fernandoabishai.scriptcut",
    "productName": "ScriptCut",
    "files": ["electron/**/*", "frontend/dist/**/*", "shared/**/*"],
    "extraResources": [
      {"from": "backend", "to": "backend"},
      {"from": "build/bin", "to": "bin", "filter": ["**/*"]},
      {"from": "runtime/models/whisper-base.json", "to": "manifests/model-manifest.json"}
    ],
    "win": {"target": "nsis"},
    "mac": {"target": "dmg", "icon": "build/icon.icns"},
    "linux": {"target": "AppImage"}
  }
}
